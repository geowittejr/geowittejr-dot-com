---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { LINKS } from '../consts';
import { getPosts, getProjects } from '../lib/content';
import { url } from '../lib/url';

const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);
const recent = (await getPosts()).slice(0, 3);
const h2 = 'mt-0 mb-4 text-2xl font-semibold';
---

<BaseLayout>
  <section class="pt-8 pb-4">
    <h1 class="mt-0 mb-3 text-4xl font-bold">Hi, I'm George.</h1>
    <p class="text-xl text-muted">
      I'm a senior software engineer. This site collects the projects I've worked on and my thoughts
      on building software.
    </p>
    <p class="flex flex-wrap gap-5">
      <a href={url('/about')}>About me</a>
      <a href={url('/projects')}>Projects</a>
      <a href={url(LINKS.resume)}>Resume</a>
    </p>
  </section>

  <section class="mt-10">
    <h2 class={h2}>Featured projects</h2>
    {
      featured.length > 0 ? (
        <>
          <ul class="m-0 grid list-none gap-4 p-0">
            {featured.map((project) => (
              <li>
                <ProjectCard project={project} />
              </li>
            ))}
          </ul>
          <p class="mt-4 mb-0"><a href={url('/projects')}>All projects →</a></p>
        </>
      ) : (
        <p class="text-muted">Coming soon.</p>
      )
    }
  </section>

  <section class="mt-10">
    <h2 class={h2}>Recent writing</h2>
    {
      recent.length > 0 ? (
        <>
          <ul class="m-0 grid list-none gap-6 p-0">
            {recent.map((post) => (
              <li>
                <PostCard post={post} />
              </li>
            ))}
          </ul>
          <p class="mt-4 mb-0"><a href={url('/writing')}>All writing →</a></p>
        </>
      ) : (
        <p class="text-muted">Coming soon.</p>
      )
    }
  </section>
</BaseLayout>
