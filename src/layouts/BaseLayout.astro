---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { OG_IMAGE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL, or site path (base is added), of the social share image. Defaults to OG_IMAGE. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(url(image), Astro.site);
const imageAlt = image === OG_IMAGE ? `${SITE_TITLE}, senior software engineer` : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Set theme before first paint to avoid a flash. Stored choice wins, else OS preference.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {
      image === OG_IMAGE && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    {
      type === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      type === 'article' && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
  </head>
  <body class="flex min-h-screen flex-col bg-bg">
    <a
      href="#main"
      class="absolute -top-12 left-4 z-10 rounded-md border border-border bg-bg px-3 py-2 focus:top-4"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="mx-auto w-full max-w-2xl flex-1 px-4 pt-8 pb-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
