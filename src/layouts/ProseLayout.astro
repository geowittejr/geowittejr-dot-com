---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter?: { title?: string; description?: string };
  title?: string;
  description?: string;
}

// Works both as a markdown `layout:` (frontmatter prop) and as a regular component.
const { frontmatter, ...rest } = Astro.props;
const title = rest.title ?? frontmatter?.title;
const description = rest.description ?? frontmatter?.description;
---

<BaseLayout title={title} description={description}>
  <article>
    {title && <h1>{title}</h1>}
    <slot />
  </article>
</BaseLayout>
