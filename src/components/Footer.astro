---
import { LINKS, SITE_TITLE } from '../consts';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="border-t border-border text-sm">
  <div class="mx-auto flex max-w-2xl flex-wrap justify-between gap-x-6 gap-y-2 px-4 py-6">
    <span class="text-muted">© {year} {SITE_TITLE}</span>
    <ul class="m-0 flex list-none flex-wrap gap-4 p-0">
      <li><a href={url(LINKS.resume)}>Resume</a></li>
      <li><a href={url('/rss.xml')}>RSS</a></li>
      <li><a href={url(LINKS.contact)}>Contact</a></li>
      <li><a href={LINKS.github}>GitHub</a></li>
      <li><a href={LINKS.linkedin}>LinkedIn</a></li>
    </ul>
  </div>
</footer>
