---
interface Props {
  tags: string[];
  label?: string;
}

const { tags, label = 'Tags' } = Astro.props;
---

{
  tags.length > 0 && (
    <ul aria-label={label} class="m-0 flex list-none flex-wrap gap-1.5 p-0">
      {tags.map((tag) => (
        <li class="rounded-sm border border-border bg-bg-subtle px-2 py-0.5 text-xs text-muted">{tag}</li>
      ))}
    </ul>
  )
}
