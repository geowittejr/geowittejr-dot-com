---
import ThemeToggle from './ThemeToggle';
import { LINKS, NAV, SITE_TITLE } from '../consts';
import { isCurrent, url } from '../lib/url';

const path = Astro.url.pathname;
const link = 'text-fg no-underline hover:text-accent';
---

<header class="border-b border-border">
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-2xl flex-wrap items-center justify-between gap-x-6 gap-y-2 p-4"
  >
    <a href={url('/')} class:list={[link, 'font-semibold']}>{SITE_TITLE}</a>
    <ul class="m-0 flex list-none flex-wrap items-center gap-x-5 gap-y-2 p-0">
      {
        NAV.map(({ href, label }) => {
          const target = url(href);
          return (
            <li>
              <a
                href={target}
                aria-current={isCurrent(target, path) ? 'page' : undefined}
                class:list={[
                  link,
                  'aria-[current=page]:text-accent aria-[current=page]:underline aria-[current=page]:decoration-2',
                ]}
              >
                {label}
              </a>
            </li>
          );
        })
      }
      <li><a href={url(LINKS.resume)} class="font-medium no-underline">Resume</a></li>
      <li><ThemeToggle client:visible /></li>
    </ul>
  </nav>
</header>
