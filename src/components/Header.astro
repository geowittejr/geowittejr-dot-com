---
import ThemeToggle from './ThemeToggle';
import { LINKS, NAV, SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
---

<header>
  <nav aria-label="Main">
    <a href="/" class="home">{SITE_TITLE}</a>
    <ul>
      {
        NAV.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
      <li><a href={LINKS.resume} class="resume">Resume</a></li>
      <li><ThemeToggle client:visible /></li>
    </ul>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
  }
  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--fg);
    text-decoration: none;
  }
  a:hover,
  a[aria-current='page'] {
    color: var(--accent);
  }
  a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .home {
    font-weight: 600;
  }
  .resume {
    color: var(--accent);
    font-weight: 500;
  }
  /* :global because the button is rendered by a React island */
  ul :global(.theme-toggle) {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  ul :global(.theme-toggle:hover) {
    color: var(--accent);
  }
</style>
